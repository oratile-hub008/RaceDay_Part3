@* View: Home/Error - used by the Home controller. *@
@{
    ViewData["Title"] = "Something went wrong";
}
<div class="container py-5 text-center">
    <div class="empty-state">
        <i class="bi bi-exclamation-octagon"></i>
        <h2>Something went wrong</h2>
        <p class="text-muted">Sorry about that - an unexpected problem occurred. Please try again.</p>
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to home</a>
    </div>
</div>
