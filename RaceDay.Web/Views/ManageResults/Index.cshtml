@* View: ManageResults/Index - used by the ManageResults controller. *@
@model ResultsViewModel
@{
    ViewData["Title"] = "Results";
}
<section class="page-hero">
    <div class="container">
        <h1>Results entry</h1>
        <p>@Model.Event.Name &middot; @UiHelper.Date(Model.Event.EventDate)</p>
    </div>
</section>

<div class="container py-4">
    <a asp-controller="ManageEvents" asp-action="Index" class="back-link"><i class="bi bi-arrow-left"></i> Back to events</a>

    @if (Model.Rows.Count == 0)
    {
        <div class="empty-state mt-3">
            <i class="bi bi-stopwatch"></i>
            <h4>No participants to capture results for</h4>
            <p class="text-muted">Results can be captured once participants have entered this event.</p>
        </div>
    }
    else
    {
        <p class="text-muted mt-3">Enter each participant's finish time (hh:mm:ss) and finishing position. Saved results are published to the participant straight away.</p>
        <div class="card">
            <div class="table-responsive">
                <table class="table rd-table align-middle mb-0">
                    <thead>
                        <tr><th>Participant</th><th>Category</th><th>Status</th><th>Finish time</th><th>Position</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            var formId = $"result-form-{row.Enrolment.Id}";
                            <tr>
                                <td class="fw-semibold">
                                    @row.Enrolment.ParticipantName
                                    <form id="@formId" asp-action="Save" method="post">
                                        <input type="hidden" name="EventId" value="@Model.Event.Id" />
                                        <input type="hidden" name="EnrolmentId" value="@row.Enrolment.Id" />
                                        <input type="hidden" name="ResultId" value="@row.Result?.Id" />
                                    </form>
                                </td>
                                <td>@row.Enrolment.CategoryName</td>
                                <td><partial name="_StatusBadge" model="row.Enrolment.Status" /></td>
                                <td><input form="@formId" name="FinishTime" value="@row.Result?.FinishTime" class="form-control form-control-sm finish-input" placeholder="00:00:00" maxlength="8" required /></td>
                                <td><input form="@formId" name="Position" type="number" min="1" value="@row.Result?.Position" class="form-control form-control-sm position-input" required /></td>
                                <td class="text-end">
                                    <button form="@formId" type="submit" class="btn btn-sm @(row.Result == null ? "btn-primary" : "btn-outline-primary")">@(row.Result == null ? "Save" : "Update")</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
