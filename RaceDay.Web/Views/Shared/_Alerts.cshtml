@* View: Shared - used by many pages. *@
@{
    var items = new[]
    {
        (Key: "Success", Css: "success", Icon: "bi-check-circle-fill"),
        (Key: "Warning", Css: "warning", Icon: "bi-exclamation-triangle-fill"),
        (Key: "Error", Css: "danger", Icon: "bi-x-octagon-fill")
    };
}
@foreach (var item in items)
{
    if (TempData[item.Key] is string message && message.Length > 0)
    {
        <div class="alert alert-@item.Css alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
            <i class="bi @item.Icon"></i>
            <div>@message</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
}
