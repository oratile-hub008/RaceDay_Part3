@* View: Shared - used by many pages. *@
@model EventInfo
<div class="card event-card h-100">
    <partial name="_EventBanner" model="Model" />
    <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <span class="type-chip type-@Model.EventType.ToLower()"><i class="bi @UiHelper.TypeIcon(Model.EventType)"></i> @Model.EventType</span>
            <span class="text-muted small">@UiHelper.DaysUntil(Model.EventDate)</span>
        </div>
        <h5 class="card-title">@Model.Name</h5>
        <ul class="event-meta list-unstyled mb-3">
            <li><i class="bi bi-calendar3"></i> @UiHelper.DateAndTime(Model.EventDate)</li>
            <li><i class="bi bi-geo-alt-fill"></i> @Model.Location</li>
            <li><i class="bi bi-signpost-split-fill"></i> @UiHelper.Distance(Model.DistanceKm)</li>
        </ul>
        <a class="btn btn-primary mt-auto" asp-controller="Events" asp-action="Details" asp-route-id="@Model.Id">View event <i class="bi bi-arrow-right"></i></a>
    </div>
</div>
