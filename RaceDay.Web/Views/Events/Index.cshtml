@* View: Events/Index - used by the Events controller. *@
@model EventBrowseViewModel
@{
    ViewData["Title"] = "Upcoming events";
}
<section class="page-hero">
    <div class="container">
        <h1>Find your next race</h1>
        <p>@Model.TotalUpcoming upcoming @(Model.TotalUpcoming == 1 ? "event" : "events") to choose from</p>
    </div>
</section>

<div class="container py-4">
    <form asp-action="Index" method="get" class="filter-bar row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label" for="search">Search</label>
            <input id="search" name="search" value="@Model.Search" class="form-control" placeholder="Event name or location" />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="type">Event type</label>
            <select id="type" name="type" class="form-select">
                <option value="">All types</option>
                <option value="Run" selected="@(Model.Type == "Run")">Run</option>
                <option value="Walk" selected="@(Model.Type == "Walk")">Walk</option>
                <option value="Cycle" selected="@(Model.Type == "Cycle")">Cycle</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label" for="distance">Distance</label>
            <select id="distance" name="distance" class="form-select">
                <option value="">Any distance</option>
                <option value="short" selected="@(Model.Distance == "short")">Up to 5 km</option>
                <option value="medium" selected="@(Model.Distance == "medium")">5 - 21 km</option>
                <option value="long" selected="@(Model.Distance == "long")">Over 21 km</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-fill"><i class="bi bi-funnel-fill"></i> Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary" title="Clear filters"><i class="bi bi-x-lg"></i></a>
        </div>
    </form>

    @if (Model.Events.Count == 0)
    {
        <div class="empty-state mt-4">
            <i class="bi bi-calendar-x"></i>
            <h4>No events match your search</h4>
            <p class="text-muted">Try a different search or clear the filters.</p>
        </div>
    }
    else
    {
        <div class="row g-4 mt-1">
            @foreach (var ev in Model.Events)
            {
                <div class="col-md-6 col-lg-4">
                    <partial name="_EventCard" model="ev" />
                </div>
            }
        </div>
    }
</div>
