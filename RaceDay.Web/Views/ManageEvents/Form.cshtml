@* View: ManageEvents/Form - used by the ManageEvents controller. *@
@model EventFormViewModel
@{
    ViewData["Title"] = Model.IsEdit ? "Edit event" : "Create event";
}
<section class="page-hero">
    <div class="container">
        <h1>@(Model.IsEdit ? "Edit event" : "Create an event")</h1>
        <p>Fill in the details participants will see</p>
    </div>
</section>

<div class="container py-4">
    <div class="card">
        <div class="card-body">
            <form asp-action="@(Model.IsEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="Name" class="form-label">Event name</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="EventType" class="form-label"></label>
                        <select asp-for="EventType" class="form-select">
                            <option value="Run">Run</option>
                            <option value="Walk">Walk</option>
                            <option value="Cycle">Cycle</option>
                        </select>
                        <span asp-validation-for="EventType" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                    <div class="col-md-5">
                        <label asp-for="EventDate" class="form-label"></label>
                        <input asp-for="EventDate" class="form-control" />
                        <span asp-validation-for="EventDate" class="text-danger small"></span>
                    </div>
                    <div class="col-md-5">
                        <label asp-for="Location" class="form-label"></label>
                        <input asp-for="Location" class="form-control" />
                        <span asp-validation-for="Location" class="text-danger small"></span>
                    </div>
                    <div class="col-md-2">
                        <label asp-for="DistanceKm" class="form-label"></label>
                        <input asp-for="DistanceKm" class="form-control" type="number" step="0.1" min="0.1" max="1000" />
                        <span asp-validation-for="DistanceKm" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Banner" class="form-label"></label>
                        @if (!string.IsNullOrEmpty(Model.ExistingBannerUrl))
                        {
                            <div class="mb-2">
                                <img src="@Model.ExistingBannerUrl" class="banner-preview" alt="Current banner" />
                                <div class="form-text">Choose a new image below to replace the current banner.</div>
                            </div>
                        }
                        <input asp-for="Banner" type="file" class="form-control" accept="image/png,image/jpeg,image/gif,image/webp" data-max-mb="5" />
                        <div class="form-text">JPG, PNG, GIF or WEBP, up to 5 MB. Shown on the event page.</div>
                        <span asp-validation-for="Banner" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">@(Model.IsEdit ? "Save changes" : "Create event")</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
